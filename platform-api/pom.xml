<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.perfplatform</groupId>
    <artifactId>performance-testing-platform</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>platform-api</artifactId>
  <packaging>jar</packaging>
  <name>Platform API</name>
  <description>
    The /api/v2/** REST surface: controllers, request/response DTOs, validation and RFC 7807
    problem responses. Calls orchestration use cases and never a Spring Data repository directly.
    Persistence entities are never exposed as responses. Spring Web and Spring Security are added
    in Increment 1B together with the first V2 endpoint.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>platform-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>platform-orchestration</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
