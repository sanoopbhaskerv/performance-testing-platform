<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.perfplatform</groupId>
    <artifactId>performance-testing-platform</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>platform-core</artifactId>
  <packaging>jar</packaging>
  <name>Platform Core</name>

  <dependencies>
    <!--
      Internal modules. platform-core is the composition root: it depends on every
      implementation module and owns application bootstrapping. Nothing depends on it.
    -->
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>platform-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>platform-engine-spi</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>platform-results</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>platform-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>platform-orchestration</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>platform-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>engine-jmeter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>engine-playwright</artifactId>
    </dependency>
    <!--
      The production execution provider. Only the composition root knows about it; orchestration
      reaches every provider through the ExecutionProvider port and has no Kubernetes types at all.
    -->
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>runner-kubernetes</artifactId>
    </dependency>

    <!--
      The local recorder bridge. Enabled only by configuration a production profile refuses; the
      composition root falls back to UnavailableRecorderBrowser otherwise.
    -->
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>runner-chrome</artifactId>
    </dependency>
    <!--
      Importers. Only the composition root knows the implementations; the API reaches every one of
      them through the SourceImporter port, so adding an importer is adding a bean.
    -->
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>importer-curl</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>importer-openapi</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>importer-har</artifactId>
    </dependency>
    <dependency>
      <groupId>com.perfplatform</groupId>
      <artifactId>importer-postman</artifactId>
    </dependency>

    <!-- Spring Boot starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-freemarker</artifactId>
    </dependency>

    <!-- YAML config parsing -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <!-- OpenAPI / Swagger UI -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <!-- Prometheus metrics -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- CSV parsing (JMeter results) -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.10.0</version>
    </dependency>

    <!-- Commons utilities -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.15.1</version>
    </dependency>

    <!-- Database -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.tomakehurst</groupId>
      <artifactId>wiremock-jre8-standalone</artifactId>
      <version>2.35.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.perfplatform.PlatformApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
